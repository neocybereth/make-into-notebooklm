{
  "manifest_version": 3,
  "name": "Make into NotebookLM",
  "description": "Turn the YouTube video you're watching into a new notebook with one click.",
  "version": "1.1.1",
  "minimum_chrome_version": "123",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Make into NotebookLM", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "commands": {
    "make-notebook": {
      "suggested_key": { "default": "Alt+Shift+N", "mac": "Alt+N" },
      "description": "Make the current YouTube video into NotebookLM"
    }
  },
  "content_scripts": [{
    "matches": ["https://notebook.google.com/*", "https://notebooklm.google.com/*"],
    "js": ["importer.js"],
    "run_at": "document_idle"
  }]
}
